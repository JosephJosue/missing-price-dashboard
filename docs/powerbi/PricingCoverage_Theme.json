{
  "name": "Pricing Coverage Dashboard",
  "dataColors": ["#2ECC71", "#E74C3C", "#F39C12", "#95A5A6", "#4f86c6", "#3b82f6", "#1e8449", "#F1C40F"],
  "foreground": "#1f2937",
  "foregroundNeutralSecondary": "#6b7280",
  "foregroundNeutralTertiary": "#9ca3af",
  "background": "#ffffff",
  "backgroundLight": "#f9fafb",
  "backgroundNeutral": "#f3f4f6",
  "tableAccent": "#3b82f6",
  "good": "#2ECC71",
  "neutral": "#F39C12",
  "bad": "#E74C3C",
  "maximum": "#2ECC71",
  "center": "#F39C12",
  "minimum": "#E74C3C",
  "hyperlink": "#3b82f6",
  "textClasses": {
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1f2937" },
    "header":  { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#6b7280" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 10, "color": "#1f2937" },
    "callout": { "fontFace": "Segoe UI", "fontSize": 28, "color": "#1f2937" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background":  [{ "show": true, "color": { "solid": { "color": "#ffffff" } }, "transparency": 0 }],
        "border":      [{ "show": true, "color": { "solid": { "color": "#e5e7eb" } }, "radius": 6 }],
        "visualHeaderTooltip": [{ "show": false }],
        "title": [{ "fontColor": { "solid": { "color": "#1f2937" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 13 }]
      }
    },
    "page": {
      "*": { "background": [{ "color": { "solid": { "color": "#f3f4f6" } }, "transparency": 0 }] }
    }
  }
}
